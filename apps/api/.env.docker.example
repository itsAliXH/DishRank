# Copy to .env.docker for docker compose:
#   cp .env.docker.example .env.docker

DATABASE_URL="postgresql://postgres:postgres@postgres:5432/dishrank?schema=public"

JWT_SECRET=change-me-in-production
PORT=3001

# Public web origin used in password-reset emails
APP_WEB_URL=http://localhost:3000

# Local Mailhog (see docker-compose mailhog service)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM="DishRank <noreply@dishrank.local>"
