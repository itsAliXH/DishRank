# Copy to .env.local when running the API on the host:
#   cp .env.local.example .env.local

DATABASE_URL="postgresql://postgres:postgres@localhost:5433/dishrank?schema=public"

JWT_SECRET=change-me-in-production
PORT=3001

# Public web origin used in password-reset emails
APP_WEB_URL=http://localhost:3000

# Local Mailhog (docker compose mailhog → host 1025 / UI 8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM="DishRank <noreply@dishrank.local>"
